# 复制为 .env 后填入。本地启动调试前必须配置 DashScope API Key。

# 阿里云百炼 / DashScope（通义）
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# 对话模型（默认 qwen-turbo，可按需改为 qwen-plus 等）
MODEL_NAME=qwen-turbo

# 向量模型（需与构建索引时一致；改模型后请重新构建索引）
EMBEDDING_MODEL=text-embedding-v3

# 可选：检索返回片段条数
# RAG_TOP_K=4

# 可选：界面品牌文案（企业换皮时修改）
# KB_BRAND_NAME=云栖杂货铺
# KB_PAGE_TITLE=电商知识库问答助手
