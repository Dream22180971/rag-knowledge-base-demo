# 复制为 .env 后按需填写。向量嵌入当前固定使用阿里云 DashScope（与索引一致）。

# ---------- 向量嵌入（构建索引必需）----------
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
EMBEDDING_MODEL=text-embedding-v3

# ---------- 对话模型（LLM_PROVIDER 控制厂商）----------
# aliyun（默认，开箱即用）| zhipu | moonshot | openai_compatible
LLM_PROVIDER=aliyun
LLM_TEMPERATURE=0.3

# 阿里通义（LLM_PROVIDER=aliyun）
MODEL_NAME=qwen-turbo

# 智谱 GLM（LLM_PROVIDER=zhipu；需安装含 ChatZhipuAI 的 langchain-community，或改用 openai_compatible）
# ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-4

# 月之暗面 Moonshot / Kimi（LLM_PROVIDER=moonshot；OpenAI 兼容协议）
# MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_MODEL=moonshot-v1-8k

# 字节方舟 / 豆包等 OpenAI 兼容网关（LLM_PROVIDER=openai_compatible）
# OPENAI_COMPATIBLE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=

# ---------- 检索与文档 ----------
# RAG_TOP_K=4
# 加载知识库时是否自动清洗（1=开）
# CLEAN_DOCUMENTS_ON_LOAD=1

# ---------- 可选：界面文案 ----------
# KB_BRAND_NAME=云栖杂货铺
# KB_PAGE_TITLE=电商知识库问答助手
